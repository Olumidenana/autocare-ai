# AutoCare AI Configuration
# Copy this file to .env and fill in your values when ready to connect live Meta WhatsApp

# Meta WhatsApp Cloud API (From developers.facebook.com)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=autocare_secret_token_123

# AI Providers (Optional: system works with built-in rule engine in simulation mode)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Set to False once you want to use live LLM APIs instead of the built-in Master Diagnostic engine
SIMULATION_MODE=True
